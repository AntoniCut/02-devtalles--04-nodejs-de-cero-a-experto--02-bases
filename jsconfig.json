{
    "compilerOptions": {
        "checkJs": true,
        "target": "ES2022",
        "module": "ESNext",
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.js",
        "src/**/*.mjs",
        "global.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}